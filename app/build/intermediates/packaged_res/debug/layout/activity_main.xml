<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Langue: FR" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type de document / نوع الوثيقة:"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spinnerDocType"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/editClient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Client / الزبون (ex: Rafik Azzouz)" />

        <EditText
            android:id="@+id/editProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chantier / الورشة (ex: Villa Azzouz)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="12dp" />

        <EditText
            android:id="@+id/editItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Désignation / المادة (ex: Fixateur Vinxya)" />

        <EditText
            android:id="@+id/editItemQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantité / الكمية (ex: 2 bidons)" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Ajouter / إضافة مادة" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:text="Générer &amp; Partager PDF / استخراج ومشاركة" />

    </LinearLayout>
</ScrollView>
